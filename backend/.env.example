# Copier ce fichier en .env et remplir les valeurs
# Ne jamais committer le fichier .env

# PostgreSQL Railway (fourni automatiquement par Railway en production)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Brevo — API transactionnelle
# Créer sur brevo.com > Paramètres > Clés API
BREVO_API_KEY=xkeysib-...

# Expéditeur des emails d'alerte
FROM_EMAIL=alertes@padel-alert.fr
FROM_NAME=Padel Alert

# Fréquence de vérification (minutes)
CHECK_INTERVAL_MINUTES=60

# Horizon de recherche (jours dans le futur)
SEARCH_DATE_HORIZON_DAYS=365
